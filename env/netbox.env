# Base de données
DB_HOST='10.0.17.1'
DB_NAME=db_netbox
DB_PASSWORD='{{ db_password }}'
DB_USER=usr_netbox

# Granian serveur ASGI
GRANIAN_BACKPRESSURE=256
GRANIAN_WORKERS=4  

# Cache Redis
REDIS_CACHE_DATABASE=1
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY=false
REDIS_CACHE_PASSWORD='{{ redis_cache_password }}'
REDIS_CACHE_SSL=false
REDIS_DATABASE=0
REDIS_HOST=redis
REDIS_INSECURE_SKIP_TLS_VERIFY=false
REDIS_PASSWORD='{{ redis_password }}'
REDIS_SSL=false

# Configuration Netbox
CSRF_TRUSTED_ORIGINS=https://netbox.infra.loutik.fr,http://netbox.infra.loutik.fr
ISOLATED_DEPLOYMENT=True
SECRET_KEY='{{ secret_key }}'
SKIP_SUPERUSER=true
WEBHOOKS_ENABLED=true
API_TOKEN_PEPPER_1='{{ api_token_pepper_1 }}'
CORS_ORIGIN_ALLOW_ALL=True
GRAPHQL_ENABLED=true
MEDIA_ROOT=/opt/netbox/netbox/media
METRICS_ENABLED=false

# Configuration for OIDC
REMOTE_AUTH_BACKEND='social_core.backends.open_id_connect.OpenIdConnectAuth'
SOCIAL_AUTH_OIDC_OIDC_ENDPOINT='https://sso.loutik.fr/application/o/netbox-prd/'
SOCIAL_AUTH_OIDC_KEY='{{ social_auth_oidc_key }}'
SOCIAL_AUTH_OIDC_SECRET='{{ social_auth_oidc_secret }}'
SOCIAL_AUTH_OIDC_SCOPE=openid profile email roles groups
REMOTE_AUTH_AUTO_CREATE_USER=true

# Configuration for PROXY
http_proxy=http://10.0.23.1:3128
https_proxy=http://10.0.23.1:3128
no_proxy=localhost,127.0.0.1,postgres,redis,redis-cache

# Configuration for PROXY
HTTP_PROXY=http://10.0.23.1:3128
HTTPS_PROXY=http://10.0.23.1:3128
NO_PROXY=localhost,127.0.0.1,postgres,redis,redis-cache
